{
    admin off
    auto_https off
    order php_server before file_server
}

:8000 {
    root * /var/www/html/public
    encode zstd br gzip

    request_body {
        max_size 500MB
    }

    # Immutable cache for versioned assets (filenames include content hash)
    @static {
        file
        path *.js *.css *.jpg *.jpeg *.webp *.gif *.png *.ico *.svg *.woff2 *.woff *.webm *.mp4
    }
    header @static Cache-Control "public, immutable, stale-while-revalidate, max-age=31536000"

    # Short cache for semi-dynamic file types
    @staticshort {
        file
        path *.json *.xml *.rss
    }
    header @staticshort Cache-Control "no-cache, max-age=3600"

    # Block access to sensitive file types
    @rejected `path('*.bak', '*.conf', '*.dist', '*.ini', '*.log', '*.orig', '*.sql', '*.swp', '*.swo', '*/.*') && !path('*/.well-known/*')`
    error @rejected 401

    php_server {
        try_files {path} frankenphp-worker.php
        resolve_root_symlink
    }
}
